# Production environment for the backend.
# Copy to /etc/thecreatestudio/backend.env on the server, fill in, then:
#   chmod 600 /etc/thecreatestudio/backend.env
# NEVER commit the real file.

SERVER_PORT=8095

# PostgreSQL
DB_URL=jdbc:postgresql://localhost:5432/the_create_studio
DB_USERNAME=tcs_app
DB_PASSWORD=change-me

# Public website URL (used in signing links sent to clients)
APP_PUBLIC_BASE_URL=http://187.127.180.221:8091
APP_OWNER_SIGNER_NAME=TheCreateStudio

# JWT signing secret — generate with:  openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string
JWT_TTL_HOURS=12

# First admin account (created on first start only if no admin exists)
ADMIN_EMAIL=you@yourdomain.com
ADMIN_PASSWORD=change-me-strong-password

# Razorpay (Dashboard → Account & Settings → API Keys). Use rzp_test_ keys first.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Razorpay Dashboard → Webhooks → secret you choose when creating the webhook
RAZORPAY_WEBHOOK_SECRET=

# Email via Gmail SMTP. MAIL_PASSWORD must be a Gmail App Password (myaccount.google.com/apppasswords).
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=thecreatestudio0405@gmail.com
MAIL_PASSWORD=your-16-character-gmail-app-password
MAIL_FROM=thecreatestudio0405@gmail.com
